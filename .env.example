# Defina apenas um destino de leads. Sem destino, a aplicação oferece o WhatsApp.
# Antes da troca do domínio, use o endpoint HTTPS autorizado do backend existente.
LEADS_LEGACY_URL=

# Para um receptor dedicado, use HTTPS e um token gerenciado no servidor.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# Apenas se o proxy sobrescrever este cabeçalho com um único IP confiável.
LEADS_TRUSTED_IP_HEADER=

# Ative só para validar com um receptor local de teste.
LEADS_ALLOW_LOOPBACK=false

# Use o domínio canônico e ative indexação só no build de produção aprovado.
SITE_URL=https://www.capitalcredgyn.com
SITE_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=

# O filme é reproduzido manualmente por padrão.
BRAND_FILM_AUTOPLAY=false
BRAND_FILM_LOOP=false
